# Deployed app origins for `npm run dev:remote` (Vite --mode remote).
# Copy to `.env.remote` (gitignored) if you need local overrides.
#
# The browser still talks to this Vite server. Only the proxy hops to these
# hosts — same stand-in as local Flask until the Platform BFF exists.
#
# These hosts use nginx Basic auth. Set USER:PASS on the matching *_BASIC_AUTH
# line (no VITE_ prefix — those values must not ship to the client bundle).

VITE_BOXOUT_BACKEND_URL=http://13.51.80.211
VITE_SIMPLEPARTS_BACKEND_URL=http://13.63.222.45
VITE_PLYWORKS_BACKEND_URL=http://13.51.215.205

# BOXOUT_BASIC_AUTH=
# SIMPLEPARTS_BASIC_AUTH=
# PLYWORKS_BASIC_AUTH=
