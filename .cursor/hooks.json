{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/check-plans.mjs",
        "timeout": 60
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/check-plans.mjs",
        "matcher": "git commit",
        "timeout": 120
      }
    ]
  }
}
